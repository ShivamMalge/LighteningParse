            736.8599853515625,
            662.9800109863281,
            748.8599853515625
          ],
          "section_id": "body",
          "source": "digital"
        },
        {
          "type": "text",
          "text": "that parallel extraction architectures can significantly",
          "bbox": [
            31.18000030517578,
            722.6900024414062,
