            734.6900024414062
          ],
          "section_id": "body",
          "source": "digital"
        },
        {
          "type": "text",
          "text": "digitally-authored PDFs by directly parsing the content",
          "bbox": [
            308.9800109863281,
            722.6900024414062,
            638.9800109863281,
            734.6900024414062
          ],
          "section_id": "body",
          "source": "digital"
        },
        {
          "type": "text",
          "text": "outperform traditional sequential approaches.",
          "bbox": [
            31.18000030517578,
            708.510009765625,
            301.1800003051758,
            720.510009765625
          ],
          "section_id": "body",
          "source": "digital"
        },
        {
          "type": "text",
          "text": "stream operators.",
          "bbox": [
            308.9800109863281,
            708.510009765625,
            410.9800109863281,
            720.510009765625
          ],
          "section_id": "body",
          "source": "digital"
